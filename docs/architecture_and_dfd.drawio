        <mxCell id="c1" value="Cyber Themed Modern UI&#xa;(Dark Glassmorphic Aesthetic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#38bdf8;fontColor=#e2e8f0;fontSize=12;fontStyle=1;" vertex="1" parent="boxClient">
          <mxGeometry x="25" y="60" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Role-Based Portals:&#xa;• Superadmin (User CRUD)&#xa;• HR Admin (Records &amp; Audit)&#xa;• Manager (Approvals)&#xa;• Employee (Self-Service)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#64748b;fontColor=#cbd5e1;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="boxClient">
