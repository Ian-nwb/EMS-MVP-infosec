        </mxCell>
        <mxCell id="srv2" value="AES-256-GCM Crypto Engine&#xa;(Field-level encryption at rest for sensitive PII &amp; Salaries)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#10b981;fontColor=#6ee7b7;fontSize=11;fontStyle=1;" vertex="1" parent="boxServices">
          <mxGeometry x="260" y="40" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="srv3" value="Structured Audit Logger&#xa;(Immutable security events: Logins, Failures, PII access)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#10b981;fontColor=#6ee7b7;fontSize=11;fontStyle=1;" vertex="1" parent="boxServices">
          <mxGeometry x="260" y="135" width="220" height="75" as="geometry" />
        </mxCell>

        <!-- DATA TIER CONTAINER -->
        <mxCell id="boxData" value="DATA TIER (MongoDB Atlas)" style="swimlane;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fontColor=#10b981;fillColor=#1e293b;strokeColor=#10b981;rounded=1;arcSize=8;startSize=35;" vertex="1" parent="1">
          <mxGeometry x="980" y="100" width="340" height="680" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Typed Mongoose ODM&#xa;Strict Schema Types, ObjectId Refs&#xa;Injection Prevention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="boxData">
          <mxGeometry x="25" y="60" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="MongoDB Atlas Cluster&#xa;(torinvr_db on AWS)&#xa;&#xa;Collections:&#xa;• Users (bcrypt hashes)&#xa;• Employees (AES encrypted)&#xa;• Departments&#xa;• Leave_Requests&#xa;• Payroll (AES encrypted)&#xa;• Attendance&#xa;• Audit_Logs (Immutable)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#022c22;strokeColor=#10b981;fontColor=#ecfdf5;fontSize=12;fontStyle=1;align=left;spacingLeft=25;" vertex="1" parent="boxData">
