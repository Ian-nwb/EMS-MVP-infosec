        </mxCell>
        <mxCell id="c3" value="Axios HTTP Client&#xa;• Auth Bearer Token Interceptor&#xa;• 401 Auto-Logout &amp; Redirection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0369a1;strokeColor=#38bdf8;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="boxClient">
          <mxGeometry x="25" y="300" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- GATEWAY & SECURITY LAYER CONTAINER -->
        <mxCell id="boxGateway" value="GATEWAY &amp; DEFENSE-IN-DEPTH SECURITY LAYER (Express.js / TLS 1.3)" style="swimlane;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fontColor=#a855f7;fillColor=#1e293b;strokeColor=#9333ea;rounded=1;arcSize=8;startSize=35;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="560" height="680" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="1. Helmet Security Headers (CSP, HSTS, X-Frame-Options)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e1065;strokeColor=#a855f7;fontColor=#f3e8ff;fontSize=11;fontStyle=1;" vertex="1" parent="boxGateway">
          <mxGeometry x="30" y="55" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. Dual Rate Limiter (Brute-Force &amp; DoS Protection)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e1065;strokeColor=#a855f7;fontColor=#f3e8ff;fontSize=11;fontStyle=1;" vertex="1" parent="boxGateway">
          <mxGeometry x="30" y="105" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. express-mongo-sanitize (Strips '$' and '.' NoSQL Injection keys)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e1065;strokeColor=#a855f7;fontColor=#f3e8ff;fontSize=11;fontStyle=1;" vertex="1" parent="boxGateway">
          <mxGeometry x="30" y="155" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4. JWT Authentication Middleware (Bearer Signature &amp; 4h Expiry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e1065;strokeColor=#a855f7;fontColor=#f3e8ff;fontSize=11;fontStyle=1;" vertex="1" parent="boxGateway">
          <mxGeometry x="30" y="205" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5. Account Lockout Guard (Auto-lock for 15 min upon 5 failed attempts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e1065;strokeColor=#a855f7;fontColor=#f3e8ff;fontSize=11;fontStyle=1;" vertex="1" parent="boxGateway">
          <mxGeometry x="30" y="255" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="6. RBAC Guard (Enforces Superadmin / HR / Manager / Employee)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e1065;strokeColor=#a855f7;fontColor=#f3e8ff;fontSize=11;fontStyle=1;" vertex="1" parent="boxGateway">
          <mxGeometry x="30" y="305" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="7. Input Validation Layer (Strict Zod Schema Allow-Lists)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e1065;strokeColor=#a855f7;fontColor=#f3e8ff;fontSize=11;fontStyle=1;" vertex="1" parent="boxGateway">
          <mxGeometry x="30" y="355" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- Services Subgroup -->
        <mxCell id="boxServices" value="Domain Controllers &amp; Application Services" style="swimlane;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fontColor=#34d399;fillColor=#064e3b;strokeColor=#059669;rounded=1;arcSize=6;startSize=30;" vertex="1" parent="boxGateway">
          <mxGeometry x="30" y="420" width="500" height="230" as="geometry" />
        </mxCell>
        <mxCell id="srv1" value="Controllers:&#xa;• Superadmin (User CRUD)&#xa;• Employee &amp; Department&#xa;• Leave &amp; Attendance&#xa;• Payroll Processing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#022c22;strokeColor=#059669;fontColor=#e2e8f0;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="boxServices">
