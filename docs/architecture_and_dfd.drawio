  <!-- PAGE 2: DATA FLOW DIAGRAM (DFD) -->
  <diagram id="dfd-page" name="2. Data Flow Diagram (DFD)">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#0f172a" math="0" shadow="0">
      <root>
        <mxCell id="dfd0" />
        <mxCell id="dfd1" parent="dfd0" />

        <!-- Header -->
        <mxCell id="dfdHdr1" value="AUTHENTICATION &amp; ACCESS CONTROL - DATA FLOW DIAGRAM (DFD)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#f8fafc;fontFamily=Helvetica;" vertex="1" parent="dfd1">
          <mxGeometry x="200" y="25" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- DFD Steps -->
        <mxCell id="dfdStep1" value="1. User Login Request&#xa;(email, password)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;fontColor=#e2e8f0;fontSize=12;fontStyle=1;" vertex="1" parent="dfd1">
          <mxGeometry x="50" y="240" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="dfdStep2" value="2. Sanitize &amp; Validate&#xa;• Strip '$' and '.' keys&#xa;• Zod Schema check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e1065;strokeColor=#a855f7;fontColor=#f3e8ff;fontSize=12;fontStyle=1;" vertex="1" parent="dfd1">
          <mxGeometry x="260" y="240" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="dfdStep3" value="3. Account Locked?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3b0764;strokeColor=#c084fc;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="dfd1">
          <mxGeometry x="460" y="225" width="130" height="100" as="geometry" />
        </mxCell>

        <mxCell id="dfdLockedOut" value="403 Forbidden&#xa;(Locked for 15 min)&#xa;Log Denied Event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#450a0a;strokeColor=#ef4444;fontColor=#fca5a5;fontSize=11;fontStyle=1;" vertex="1" parent="dfd1">
          <mxGeometry x="450" y="80" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dfdStep4" value="4. bcrypt.compare&#xa;(candidate vs hash)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3b0764;strokeColor=#c084fc;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="dfd1">
          <mxGeometry x="640" y="225" width="130" height="100" as="geometry" />
        </mxCell>

        <mxCell id="dfdFail" value="401 Unauthorized&#xa;Increment Failures (+1)&#xa;Lock if &gt;= 5 attempts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#450a0a;strokeColor=#ef4444;fontColor=#fca5a5;fontSize=11;fontStyle=1;" vertex="1" parent="dfd1">
          <mxGeometry x="630" y="80" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dfdStep5" value="5. Issue Signed JWT&#xa;(Role claim + 4h expiry)&#xa;Log Success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;fontColor=#ecfdf5;fontSize=12;fontStyle=1;" vertex="1" parent="dfd1">
          <mxGeometry x="820" y="240" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="dfdStep6" value="6. RBAC Role Check" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3b0764;strokeColor=#c084fc;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="dfd1">
          <mxGeometry x="1030" y="225" width="130" height="100" as="geometry" />
        </mxCell>

        <mxCell id="dfdDenied" value="403 Forbidden&#xa;Role Insufficient&#xa;Audit Log Written" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#450a0a;strokeColor=#ef4444;fontColor=#fca5a5;fontSize=11;fontStyle=1;" vertex="1" parent="dfd1">
          <mxGeometry x="1020" y="80" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- Downstream Execution -->
        <mxCell id="dfdStep7" value="7. Parameterized Mongoose Query&#xa;(Strict typed schemas &amp; ObjectId refs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#38bdf8;fontColor=#e2e8f0;fontSize=12;fontStyle=1;" vertex="1" parent="dfd1">
          <mxGeometry x="970" y="420" width="250" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dfdStep8" value="8. AES-256-GCM Cryptography&#xa;(Encrypt/Decrypt sensitive fields at rest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;fontColor=#6ee7b7;fontSize=12;fontStyle=1;" vertex="1" parent="dfd1">
          <mxGeometry x="970" y="520" width="250" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dfdStep9" value="9. Secure Response over TLS 1.3&#xa;(Sanitized JSON, No stack traces)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0369a1;strokeColor=#38bdf8;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="dfd1">
          <mxGeometry x="970" y="620" width="250" height="60" as="geometry" />
        </mxCell>

        <!-- DFD Edges -->
        <mxCell id="dfde1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#38bdf8;strokeWidth=2;" edge="1" parent="dfd1" source="dfdStep1" target="dfdStep2" />
        <mxCell id="dfde2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#a855f7;strokeWidth=2;" edge="1" parent="dfd1" source="dfdStep2" target="dfdStep3" />
        <mxCell id="dfde3a" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ef4444;strokeWidth=2;fontColor=#ef4444;" edge="1" parent="dfd1" source="dfdStep3" target="dfdLockedOut" />
        <mxCell id="dfde3b" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10b981;strokeWidth=2;fontColor=#10b981;" edge="1" parent="dfd1" source="dfdStep3" target="dfdStep4" />
        <mxCell id="dfde4a" value="Mismatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ef4444;strokeWidth=2;fontColor=#ef4444;" edge="1" parent="dfd1" source="dfdStep4" target="dfdFail" />
        <mxCell id="dfde4b" value="Match (Success)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10b981;strokeWidth=2;fontColor=#10b981;" edge="1" parent="dfd1" source="dfdStep4" target="dfdStep5" />
        <mxCell id="dfde5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10b981;strokeWidth=2;" edge="1" parent="dfd1" source="dfdStep5" target="dfdStep6" />
        <mxCell id="dfde6a" value="Denied" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ef4444;strokeWidth=2;fontColor=#ef4444;" edge="1" parent="dfd1" source="dfdStep6" target="dfdDenied" />
        <mxCell id="dfde6b" value="Allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10b981;strokeWidth=2;fontColor=#10b981;" edge="1" parent="dfd1" source="dfdStep6" target="dfdStep7" />
        <mxCell id="dfde7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#38bdf8;strokeWidth=2;" edge="1" parent="dfd1" source="dfdStep7" target="dfdStep8" />
        <mxCell id="dfde8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10b981;strokeWidth=2;" edge="1" parent="dfd1" source="dfdStep8" target="dfdStep9" />

      </root>
